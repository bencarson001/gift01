{
  "name": "BookReview",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "review_text": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "occasion": {
      "type": "string"
    }
  },
  "required": [
    "book_id",
    "rating"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {},
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}