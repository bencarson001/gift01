{
  "name": "Order",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string",
      "description": "Reference to the Book entity"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "digital",
        "printed",
        "subscription"
      ],
      "description": "Type of product purchased"
    },
    "price_gbp": {
      "type": "number",
      "description": "Price in GBP"
    },
    "vat_amount": {
      "type": "number",
      "description": "VAT amount included"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "processing",
        "shipped",
        "delivered",
        "refunded"
      ],
      "default": "pending"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "shipping_address": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "postcode": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "default": "GB"
        }
      }
    },
    "printful_order_id": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string",
      "description": "Courier tracking number"
    },
    "tracking_carrier": {
      "type": "string",
      "description": "Carrier name e.g. Royal Mail, DPD"
    },
    "tracking_url": {
      "type": "string",
      "description": "Direct tracking URL from carrier"
    },
    "tracking_status": {
      "type": "string",
      "enum": [
        "not_dispatched",
        "in_production",
        "dispatched",
        "out_for_delivery",
        "delivered",
        "exception"
      ],
      "default": "not_dispatched",
      "description": "Current delivery status"
    },
    "dispatched_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "recipient_email": {
      "type": "string"
    },
    "download_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "book_id",
    "product_type",
    "price_gbp"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}